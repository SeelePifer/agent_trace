{
  "name": "@agenttrace/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/migrate.ts",
    "retention:run": "tsx src/retention.ts",
    "test": "vitest run --exclude src/integration/**",
    "test:integration": "vitest run src/integration",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@agenttrace/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
